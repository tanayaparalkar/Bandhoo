# ==============================================================================
# Bandhoo Terraform Variables Configuration (AWS Example Template)
# Copy this file to terraform.tfvars and customize for your AWS environment.
# NEVER commit real credentials, access keys, or secrets to Git.
# ==============================================================================

# Project & Environment
project_name = "bandhoo"
environment  = "dev"

# Target AWS Region (Default: Mumbai / ap-south-1)
aws_region = "ap-south-1"

# Container Application Specifications
container_image_tag = "1.0.0"
container_port      = 8001

# AWS Fargate Resource Allocation
# Supported (CPU units, Memory in MiB) combinations:
# - (256, 512 | 1024 | 2048)
# - (512, 1024 | 2048 | 3072 | 4096)
# - (1024, 2048 to 8192)
fargate_cpu    = "512"  # 0.5 vCPU
fargate_memory = "1024" # 1024 MiB (1 GB)

# Security & Inbound Access
# WARNING: Default ["0.0.0.0/0"] opens port 8001 directly to the public internet.
# For tighter security, restrict this to your specific public IP (e.g. ["203.0.113.45/32"]).
inbound_cidr_blocks = ["203.0.113.45/32"]

# Cost Optimizations
log_retention_in_days     = 7 # Retain CloudWatch logs for 7 days
ecr_image_retention_count = 5 # Retain only latest 5 images in ECR

# CORS Allowed Origins (Comma-separated)
cors_origins = "http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# Resource Tags
tags = {
  Project     = "Bandhoo"
  ManagedBy   = "Terraform"
  Environment = "dev"
  Component   = "Backend"
}
