# ==============================================================================
# Bandhoo Monitoring Environment Variables Template
# Copy this file to monitoring/.env and customize before starting Docker Compose.
# NEVER commit production passwords to version control.
# ==============================================================================

# Grafana Admin Credentials (Configure in your local monitoring/.env)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_to_a_secure_password_before_starting

# Target Bandhoo Backend Address (Used for reference / documentation)
BANDHOO_BACKEND_TARGET=your-ecs-public-ip:8001

